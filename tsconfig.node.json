{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "ESNext", "skipLibCheck": true,
    "moduleResolution": "Bundler", "resolveJsonModule": true, "isolatedModules": true, "allowImportingTsExtensions": true,
    "noEmit": true, "strict": true, "types": ["node"]
  },
  "include": ["vite.config.ts", "api/**/*.ts", "tests/**/*.ts"]
}
